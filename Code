import random
#Welcome message and game rules
print("Welcome!\n")
print("Game Rules:")
print('''Rock vs Paper: Paper win''')
print('''Rock vs Scissors: Rock win''')
print('''Paper vs Scissors: Scissors win''')
print("\nGood Luck!\n")
print("----------------------------------------------------------------------")

#options for the game
options = ["Rock🪨", "Paper📄", "Scissors✂️"] 

#real game loop
while True:

    # Computer selecting its choice
    print("\nFirst Computer's Turn. Let it choose....")
    computer_choice = random.choice(options)

    # User options message
    print("\nNow it's your turn. Choose wisely!")
    print("Choose your option:")
    print("🪨 - 1")
    print("📄 - 2")
    print("✂️ - 3")

    # User choice input with error handling
    try:
        user_number_choice = int(input("Enter your choice: "))
    except ValueError:
        print("Please enter NUMBER.\n")
        continue

    while user_number_choice < 1 or user_number_choice > 3:
        user_number_choice = int(input("Please enter a Number between 1 and 3: "))

    # Selecting user choice from options list
    user_choice = options[user_number_choice - 1]
    
    # DIsplaying Both User and Computer Choices
    print("\nUser user_choice is: ", user_choice)
    print("Computer choice is: ", computer_choice)
    print(user_choice, "vs", computer_choice)


    # Finding the winner
    if user_choice == computer_choice:
        print("\nIt was a Tie!🤝")
    elif (
        (user_choice == "Rock🪨" and computer_choice == "Scissors✂️") or
        (user_choice == "Paper📄" and computer_choice == "Rock🪨") or
        (user_choice == "Scissors✂️" and computer_choice == "Paper📄")
    ):
        print("\nYou Win!🎉")
    else:
        print("\nComputer Win!🖳")

    print("----------------------------------------------------------------------")

    #ask user if they want to play again or not
    while True:
        wish =int(input("\n\nWant to try again?(0/1): "))

        if wish in [0, 1]:
            break

        print("Please enter 0 or 1.")

    if wish == 0:
        break
  
# Last message if user do not want to play again
print("\nHope you enjoyed the game!")
