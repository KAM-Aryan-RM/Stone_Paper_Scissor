import random

print("Welcome!\n")
print("Winning Rules:")
print("Rock vs Paper then Paper wins")
print("Rock vs Scissors then Rock wins")
print("Paper vs Scissors then Scissors wins")
print("1 for 🪨 2 for 📄  3 for ✂️")
print("Good Luck!\n")

choices = ["Rock🪨", "Paper📄", "Scissors✂️"]

while True:

    print("\nChoose your option:")
    print("🪨 - Rock")
    print("📄 - Paper")
    print("✂️ - Scissors")


    try:
        choice = int(input("Enter your choice: "))
    except ValueError:
        print("Please enter NUMBER.\n")
        continue

    while choice < 1 or choice > 3:
        choice = int(input("Please enter a Number between 1 and 3: "))

    user_choice = choices[choice - 1]

    print("\nUser choice is:", user_choice)
    print("Now it's Computer's Turn...")

    comp_choice = random.randint(1, 3)
    computer_choice = choices[comp_choice - 1]
    print("Computer choice is:", computer_choice)

    print(user_choice, "vs", computer_choice)

    if choice == comp_choice:
        print("\nIt's a Tie!")

    elif (
        (choice == 1 and comp_choice == 3) or
        (choice == 2 and comp_choice == 1) or
        (choice == 3 and comp_choice == 2)
    ):
        print("You Wins!")

    else:
        print("Computer Wins!🖳")

    while True:
        ans =int(input("\nDo you want to play again? (0/1): "))

        if ans in [0, 1]:
            break

        print("Please enter 0 or 1.")

    if ans == 0:
        break
  
print("\nThanks for playing!")
